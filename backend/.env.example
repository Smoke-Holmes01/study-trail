GENERATION_BASE_URL=https://api.openai.com/v1
GENERATION_API_KEY=
SILICONFLOW_API_KEY=
STORAGE_ROOT=../.local/storage
CURSOR_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Files in ../config are one-time import sources; runtime configuration is managed in the database.
# Optional override for deployments whose config directory is elsewhere:
# CONFIG_ROOT=../config
EXA_API_KEY=
# bootstrap_platform.py generates a key only when none exists and no credentials have been encrypted.
# Never replace the key for an existing installation. Back it up together with the database.
# PLATFORM_KEY_ID=local-v1
# PLATFORM_KEYS={"local-v1":"YOUR_FERNET_KEY"}
# stdio services are restricted by deployment allowlists (JSON arrays of exact executable/directory paths):
STDIO_ALLOWED_COMMANDS=[]
STDIO_ALLOWED_DIRECTORIES=[]
